# ── Laravel API (Fase 5: menggantikan Supabase sebagai backend utama) ──
NEXT_PUBLIC_LARAVEL_API_URL=http://localhost:8000/api

# ── Supabase (LEGACY — tidak lagi dipakai untuk data/auth setelah Fase 5,
# data asli tetap dipertahankan di Supabase sebagai cadangan sesuai aturan
# migrasi, env ini disisakan untuk referensi/rollback kalau diperlukan) ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never expose to client

# ── AI Planner ────────────────────────────────────────────
# CATATAN Fase 6: AI Planner sekarang 100% dipanggil lewat Laravel API
# (POST /api/ai-planner). Frontend TIDAK PERNAH memanggil OpenRouter
# langsung lagi — key AI HANYA boleh ada di Laravel/.env (lihat
# wihsata-api/.env.example: OPENROUTER_API_KEY, OPENROUTER_MODEL).

# ── App ───────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Wihsata
