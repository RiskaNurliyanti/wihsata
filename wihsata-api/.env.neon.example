# ── Koneksi Neon (PostgreSQL) — Fase 2 ──────────────────────────────────
# Ambil connection string dari Neon Dashboard > Connection Details.
# Pakai "Pooled connection" untuk production/serverless, "Direct connection"
# kalau perlu jalankan migration (beberapa operasi DDL/extension lebih stabil
# lewat direct connection, bukan lewat pgbouncer pooler).

DB_CONNECTION=pgsql
DB_HOST=ep-xxxxxxxx.ap-southeast-1.aws.neon.tech
DB_PORT=5432
DB_DATABASE=wihsata
DB_USERNAME=your-neon-user
DB_PASSWORD=your-neon-password

# WAJIB untuk Neon — koneksi tanpa SSL akan ditolak.
DB_SSLMODE=require

# Opsional: kalau pakai Neon pooled endpoint (nama host biasanya diakhiri
# "-pooler"), set PGBOUNCER-friendly options di config/database.php bila perlu.
