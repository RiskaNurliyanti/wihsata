APP_NAME=Wihsata
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Asia/Jakarta
APP_URL=http://localhost:8000

# Domain frontend Next.js Anda — WAJIB diisi benar untuk CORS & Sanctum
# (tanpa protokol untuk SANCTUM_STATEFUL_DOMAINS, dengan protokol untuk FRONTEND_URL)
FRONTEND_URL=http://localhost:3000
SANCTUM_STATEFUL_DOMAINS=localhost:3000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_LEVEL=debug

# ── Database (Postgres) ──────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=wihsata
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

CACHE_STORE=database
QUEUE_CONNECTION=database

# ── Email (dibutuhkan untuk fitur Lupa Password) ─────────────────
# Untuk development, pakai Mailtrap/Mailpit dulu. Untuk produksi,
# pakai layanan seperti Resend/Postmark/SES.
MAIL_MAILER=smtp
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@wihsata.com"
MAIL_FROM_NAME="${APP_NAME}"

# ── Layanan eksternal (proxy/AI) ──────────────────────────────────
# AI Planner (WAJIB — tanpa ini AI Planner tidak akan jalan)
OPENROUTER_API_KEY=
# Model gratis Meta Llama sudah tidak tersedia lagi di OpenRouter (per
# pertengahan 2026). Model di bawah ini dipilih karena: gratis, ringan
# (12B parameter aktif — jauh lebih cepat dari varian 550B), dan
# direkomendasikan kuat untuk structured/JSON output (dibutuhkan AI
# Planner). Katalog model gratis OpenRouter berubah cepat — cek ulang di
# https://openrouter.ai/collections/free-models kalau model ini nanti
# di-delist. Ingat juga: free tier dibatasi 50 request/hari (naik ke
# 1000/hari kalau sudah pernah top-up saldo minimal $10).
OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Reverse geocoding (opsional — default ke instance publik Nominatim)
NOMINATIM_URL=https://nominatim.openstreetmap.org

# Proxy cuaca (opsional — default ke Open-Meteo publik, tanpa API key)
OPEN_METEO_URL=https://api.open-meteo.com/v1

# Routing jarak/waktu tempuh riil untuk AI Planner (Fase 6) — opsional,
# default ke demo server publik OSRM. Untuk produksi/traffic tinggi,
# disarankan self-host OSRM sendiri (demo server ada rate limit).
OSRM_URL=https://router.project-osrm.org

# ── Storage upload foto (opsional) ──────────────────────────────────────
# Default: file upload disimpan di disk lokal ('public') — CUKUP untuk
# development, TAPI akan HILANG setiap redeploy kalau di-hosting di
# platform cloud yang filesystem-nya ephemeral (Render, Railway, Fly.io,
# dst). Untuk produksi di platform seperti itu, setup Backblaze B2 (gratis
# 10GB, tanpa kartu kredit — https://backblaze.com/sign-up/cloud-storage),
# lalu isi 5 baris di bawah dan set UPLOAD_DISK=b2.
#
# Cara dapat nilainya di dashboard Backblaze:
# 1. Buat bucket baru (public) → B2_BUCKET = nama bucket
# 2. App Keys → Add a New Application Key → B2_ACCESS_KEY_ID & B2_SECRET_ACCESS_KEY
# 3. Halaman bucket akan tampilkan "Endpoint" (mis. s3.us-west-004.backblazeb2.com)
#    → B2_ENDPOINT = https://s3.us-west-004.backblazeb2.com (WAJIB pakai https://)
#    → B2_REGION = bagian tengahnya (mis. us-west-004)
# 4. B2_URL = https://f004.backblazeb2.com/file/NAMA_BUCKET_ANDA (cek "Friendly URL"
#    di halaman detail bucket, angka setelah "f" bisa beda per akun)
UPLOAD_DISK=public
B2_ACCESS_KEY_ID=
B2_SECRET_ACCESS_KEY=
B2_BUCKET=
B2_ENDPOINT=
B2_REGION=us-west-004
B2_URL=

# Alternatif Backblaze B2 kalau tidak mau input kartu kredit sama sekali —
# Backblaze mewajibkan kartu untuk membuat BUCKET PUBLIK (walau daftar akun
# gratis tanpa kartu). Supabase Storage tidak punya syarat ini.
# Setup: buat project di supabase.com (gratis, 1GB storage, tanpa kartu) →
# Storage → buat bucket baru (Public) → Project Settings → Data API →
# S3 Connection untuk ambil nilai di bawah.
# UPLOAD_DISK=supabase
SUPABASE_S3_ACCESS_KEY_ID=
SUPABASE_S3_SECRET_ACCESS_KEY=
SUPABASE_S3_BUCKET=
SUPABASE_S3_REGION=ap-southeast-1
SUPABASE_S3_ENDPOINT=https://xxxxxxxxxxxx.supabase.co/storage/v1/s3
SUPABASE_S3_URL=https://xxxxxxxxxxxx.supabase.co/storage/v1/object/public/nama-bucket-anda
